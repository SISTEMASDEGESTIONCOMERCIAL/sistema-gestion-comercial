digraph G {rankdir=TB; graph [bgcolor="white",pad=0.2]; node [fontname="Arial",fontsize=10,style=filled,fillcolor="#eef5ff",color="#355c7d"]; edge [fontname="Arial",fontsize=9]; inicio [label="Inicio",shape=oval,fillcolor="#d9ead3"]; codigo [label="Ingresar código",shape=parallelogram]; buscar [label="Buscar producto",shape=box]; existe [label="¿Existe?",shape=diamond,fillcolor="#fff2cc"]; mostrar [label="Mostrar información actual",shape=box]; editar [label="Ingresar campos a modificar",shape=parallelogram]; valido [label="¿Datos válidos?",shape=diamond,fillcolor="#fff2cc"]; guardar [label="Guardar cambios",shape=box]; error [label="Mostrar error",shape=box,fillcolor="#f4cccc"]; fin [label="Fin",shape=oval,fillcolor="#d9ead3"]; inicio->codigo->buscar->existe; existe->mostrar[label="Sí"]; existe->error[label="No"]; mostrar->editar->valido; valido->guardar[label="Sí"]; valido->error[label="No"]; guardar->fin; error->fin;}
