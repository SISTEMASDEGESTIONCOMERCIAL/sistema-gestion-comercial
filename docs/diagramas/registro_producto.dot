digraph G {rankdir=TB; graph [bgcolor="white",pad=0.2]; node [fontname="Arial",fontsize=10,style=filled,fillcolor="#eef5ff",color="#355c7d"]; edge [fontname="Arial",fontsize=9]; inicio [label="Inicio",shape=oval,fillcolor="#d9ead3"]; datos [label="Ingresar datos del producto",shape=parallelogram]; campos [label="¿Campos obligatorios completos?",shape=diamond,fillcolor="#fff2cc"]; codigo [label="¿Código duplicado?",shape=diamond,fillcolor="#fff2cc"]; valid [label="¿Precio y cantidades válidos?",shape=diamond,fillcolor="#fff2cc"]; guardar [label="Guardar producto en JSON",shape=box]; ok [label="Mostrar confirmación",shape=parallelogram]; error [label="Mostrar error",shape=box,fillcolor="#f4cccc"]; fin [label="Fin",shape=oval,fillcolor="#d9ead3"]; inicio->datos->campos; campos->codigo[label="Sí"]; campos->error[label="No"]; codigo->valid[label="No"]; codigo->error[label="Sí"]; valid->guardar[label="Sí"]; valid->error[label="No"]; guardar->ok->fin; error->fin;}
