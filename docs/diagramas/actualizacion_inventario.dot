digraph G {rankdir=TB; graph [bgcolor="white",pad=0.2]; node [fontname="Arial",fontsize=10,style=filled,fillcolor="#eef5ff",color="#355c7d"]; edge [fontname="Arial",fontsize=9]; inicio [label="Inicio",shape=oval,fillcolor="#d9ead3"]; datos [label="Ingresar código y cantidad",shape=parallelogram]; existe [label="¿Producto activo existe?",shape=diamond,fillcolor="#fff2cc"]; cantidad [label="¿Cantidad entera positiva?",shape=diamond,fillcolor="#fff2cc"]; sumar [label="Sumar cantidad a existencias",shape=box]; guardar [label="Guardar productos",shape=box]; historial [label="Registrar fecha, tipo, cantidad y descripción",shape=box]; ok [label="Mostrar existencias actualizadas",shape=parallelogram]; error [label="Mostrar error",shape=box,fillcolor="#f4cccc"]; fin [label="Fin",shape=oval,fillcolor="#d9ead3"]; inicio->datos->existe; existe->cantidad[label="Sí"]; existe->error[label="No"]; cantidad->sumar[label="Sí"]; cantidad->error[label="No"]; sumar->guardar->historial->ok->fin; error->fin;}
