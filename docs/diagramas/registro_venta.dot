digraph G {rankdir=TB; graph [bgcolor="white",pad=0.2]; node [fontname="Arial",fontsize=10,style=filled,fillcolor="#eef5ff",color="#355c7d"]; edge [fontname="Arial",fontsize=9]; inicio [label="Inicio",shape=oval,fillcolor="#d9ead3"]; leer [label="Leer productos activos",shape=box]; hay [label="¿Hay existencias?",shape=diamond,fillcolor="#fff2cc"]; seleccionar [label="Elegir producto y cantidad",shape=parallelogram]; valido [label="¿Producto y cantidad válidos?",shape=diamond,fillcolor="#fff2cc"]; stock [label="¿Stock suficiente?",shape=diamond,fillcolor="#fff2cc"]; carrito [label="Agregar línea al carrito",shape=box]; otro [label="¿Agregar otro producto?",shape=diamond,fillcolor="#fff2cc"]; cliente [label="Validar cliente opcional",shape=box]; calcular [label="Calcular subtotal, IVA 12% y total",shape=box]; guardar [label="Guardar venta",shape=box]; actualizar [label="Actualizar existencias y registrar salida",shape=box]; recibo [label="Mostrar resumen de venta",shape=parallelogram]; error [label="Informar error/cancelación",shape=box,fillcolor="#f4cccc"]; fin [label="Fin",shape=oval,fillcolor="#d9ead3"]; inicio->leer->hay; hay->seleccionar[label="Sí"]; hay->error[label="No"]; seleccionar->valido; valido->stock[label="Sí"]; valido->seleccionar[label="No"]; stock->carrito[label="Sí"]; stock->seleccionar[label="No"]; carrito->otro; otro->seleccionar[label="Sí"]; otro->cliente[label="No"]; cliente->calcular->guardar->actualizar->recibo->fin; error->fin;}
