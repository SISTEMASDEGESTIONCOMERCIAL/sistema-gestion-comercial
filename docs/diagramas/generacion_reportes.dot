digraph G {rankdir=TB; graph [bgcolor="white",pad=0.2]; node [fontname="Arial",fontsize=10,style=filled,fillcolor="#eef5ff",color="#355c7d"]; edge [fontname="Arial",fontsize=9]; inicio [label="Inicio",shape=oval,fillcolor="#d9ead3"]; leer [label="Leer productos, ventas y movimientos",shape=box]; datos [label="¿Hay datos?",shape=diamond,fillcolor="#fff2cc"]; calc1 [label="Calcular ingresos y unidades por producto",shape=box]; calc2 [label="Calcular stock bajo y valor del inventario",shape=box]; calc3 [label="Calcular promedio diario de ventas",shape=box]; mostrar [label="Mostrar reporte",shape=parallelogram]; vacio [label="Informar que no hay datos",shape=box,fillcolor="#f4cccc"]; fin [label="Fin",shape=oval,fillcolor="#d9ead3"]; inicio->leer->datos; datos->calc1[label="Sí"]; datos->vacio[label="No"]; calc1->calc2->calc3->mostrar->fin; vacio->fin;}
