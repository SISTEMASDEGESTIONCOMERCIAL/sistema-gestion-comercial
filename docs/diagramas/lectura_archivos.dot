digraph G {rankdir=TB; graph [bgcolor="white",pad=0.2]; node [fontname="Arial",fontsize=10,style=filled,fillcolor="#eef5ff",color="#355c7d"]; edge [fontname="Arial",fontsize=9]; inicio [label="Inicio",shape=oval,fillcolor="#d9ead3"]; ruta [label="Construir ruta dentro de data",shape=box]; existe [label="¿Archivo existe?",shape=diamond,fillcolor="#fff2cc"]; leer [label="Leer y analizar JSON",shape=box]; valido [label="¿JSON válido?",shape=diamond,fillcolor="#fff2cc"]; datos [label="Devolver datos",shape=parallelogram]; vacio [label="Aviso y estructura vacía",shape=box,fillcolor="#f4cccc"]; fin [label="Fin",shape=oval,fillcolor="#d9ead3"]; inicio->ruta->existe; existe->leer[label="Sí"]; existe->vacio[label="No"]; leer->valido; valido->datos[label="Sí"]; valido->vacio[label="No"]; datos->fin; vacio->fin;}
